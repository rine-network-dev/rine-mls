"""Type stubs for the compiled `rine_mls` extension.

The napi binding's `index.d.ts` is generated from the Rust source; PyO3 has no
equivalent, so this file is written by hand — and `tests/test_stub.py` compares
it against the real module, so a method added to the binding without being added
here fails the suite rather than quietly going untyped.

Prose lives on the Rust side. What is here is the shape.
"""

from typing import Optional

# Ciphersuite ids, as the server persists them in `mls_cipher_suite`.
CIPHER_SUITE_CLASSICAL: int
CIPHER_SUITE_XWING: int
# The suite a NEW rine group is created with. Read this rather than choosing.
CIPHER_SUITE_DEFAULT: int

# Leading byte of an `mls-v1` `encrypted_payload`.
APP_MESSAGE_TAG: int

# KeyPackage pool policy, and the self-read cache's bounds.
KEY_PACKAGE_TARGET: int
KEY_PACKAGE_LOW_WATER: int
KEY_PACKAGE_MAX_BATCH: int
SELF_READ_MAX_ENTRIES: int
SELF_READ_MAX_BYTES: int

# Prior epochs kept when `epoch_retention_limit` is left unset, and the
# server-side message retention that window is derived from.
EPOCH_RETENTION_DEFAULT: int
MESSAGE_RETENTION_DAYS: int

# Raw ML-KEM-768, for the 1:1 `hpke-hybrid-v1` DM envelope. FIPS 203 encodings,
# the same ones `@noble/post-quantum` produces. Not the group KEM.
ML_KEM768_PUBLIC_KEY_SIZE: int
ML_KEM768_PRIVATE_KEY_SIZE: int
ML_KEM768_CIPHERTEXT_SIZE: int
ML_KEM768_SHARED_SECRET_SIZE: int

def ml_kem768_generate_key_pair() -> tuple[bytes, bytes]:
    """Mint a key pair, returned as ``(public_key, private_key)``."""

def ml_kem768_public_key(private_key: bytes) -> bytes:
    """The public key a private key carries, checked against its own hash."""

def ml_kem768_encapsulate(public_key: bytes) -> tuple[bytes, bytes]:
    """Encapsulate, returned as ``(ciphertext, shared_secret)``."""

def ml_kem768_decapsulate(ciphertext: bytes, private_key: bytes) -> bytes:
    """Recover the shared secret. A wrong key yields a pseudorandom one, per
    FIPS 203 implicit rejection — the AEAD is what refuses."""

class RineMlsError(Exception):
    """Base class for every failure raised by rine's MLS core."""

    code: str

class MlsProtocolError(RineMlsError): ...
class MlsStoreError(RineMlsError): ...
class EpochConflictError(RineMlsError): ...
class EpochOverflowError(RineMlsError): ...
class UnexpectedBlobError(RineMlsError): ...
class UnexpectedMessageError(RineMlsError): ...
class MissingWelcomeError(RineMlsError): ...
class UnreadableKeyPackageError(RineMlsError): ...
class CipherSuiteMismatchError(RineMlsError): ...
class GroupInactiveError(RineMlsError): ...
class SelfMessageNotCachedError(RineMlsError): ...
class KeyPackageBatchTooLargeError(RineMlsError): ...
class InvalidEpochRetentionError(RineMlsError): ...
class InvalidSigningSeedError(RineMlsError): ...
class UnsupportedCipherSuiteError(RineMlsError): ...
class UnexpectedVersionTagError(RineMlsError): ...
class EmptyFrameError(RineMlsError): ...
class UnreadableCredentialError(RineMlsError): ...
class MlsPanicError(RineMlsError): ...
class MlsPoisonedError(RineMlsError): ...
class MlKemError(RineMlsError): ...

class CommitBundle:
    """The commit to broadcast, one Welcome per added member in add order, a
    fresh GroupInfo, and the epoch the group is now at."""

    @property
    def commit(self) -> bytes: ...
    @property
    def welcomes(self) -> list[bytes]: ...
    @property
    def group_info(self) -> bytes: ...
    @property
    def epoch(self) -> int: ...

class AppMessage:
    """A decrypted `mls-v1` message: the signed rine envelope, and its sender."""

    @property
    def envelope(self) -> bytes: ...
    @property
    def sender_index(self) -> int: ...

class MemberIdentity:
    """One occupied ratchet-tree leaf: where it sits, and whose it is."""

    @property
    def index(self) -> int: ...
    @property
    def identity(self) -> bytes: ...

class MlsGroup:
    def group_id(self) -> bytes: ...
    def epoch(self) -> int: ...
    def cipher_suite(self) -> int: ...
    def is_active(self) -> bool: ...
    def member_index(self, identity: bytes) -> int: ...
    def member_identities(self) -> list[MemberIdentity]: ...
    def current_member_index(self) -> int: ...
    def group_info(self) -> bytes: ...
    def last_commit(self) -> Optional[CommitBundle]: ...
    def add_member(self, key_package: bytes) -> CommitBundle: ...
    def add_members(self, key_packages: list[bytes]) -> CommitBundle: ...
    def remove_member(self, leaf_index: int) -> CommitBundle: ...
    def apply_commit(self, commit: bytes) -> int: ...
    def encrypt_application_message(self, envelope: bytes) -> bytes: ...
    def decrypt_application_message(self, payload: bytes) -> AppMessage: ...
    def save(self) -> None: ...

class MlsClient:
    def __init__(
        self,
        store_root: str,
        signing_seed: bytes,
        cipher_suite: int,
        *,
        epoch_retention_limit: Optional[int] = None,
    ) -> None: ...
    def cipher_suite(self) -> int: ...
    def public_key(self) -> bytes: ...
    def generate_key_package(self) -> bytes: ...
    def generate_key_packages(self, count: int) -> list[bytes]: ...
    def key_package_count(self) -> int: ...
    def replenish_key_packages(self) -> list[bytes]: ...
    def drain_and_republish_key_packages(self) -> list[bytes]: ...
    def create_group(self, group_id: bytes) -> MlsGroup: ...
    def create_group_with_members(
        self, group_id: bytes, key_packages: list[bytes]
    ) -> MlsGroup: ...
    def join_from_welcome(self, welcome: bytes) -> MlsGroup: ...
    def join_by_external_commit(self, group_info: bytes) -> MlsGroup: ...
    def resync_by_external_commit(
        self, group_info: bytes, stale_leaf: int
    ) -> MlsGroup: ...
    def load_group(self, group_id: bytes) -> MlsGroup: ...
    def delete_group_state(self, group_id: bytes) -> None: ...
