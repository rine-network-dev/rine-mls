class CommitBundle:
    """The commit to broadcast, one Welcome per added member in add order, a
    fresh GroupInfo, and the epoch the group is now at."""

    @property
    def commit(self) -> bytes: ...
    @property
    def welcomes(self) -> list[bytes]: ...
    @property
    def group_info(self) -> bytes: ...
    @property
    def epoch(self) -> int: ...

class AppMessage:
    """A decrypted `mls-v1` message: the signed rine envelope, and its sender."""

    @property
    def envelope(self) -> bytes: ...
    @property
    def sender_index(self) -> int: ...

class MemberIdentity:
    """One occupied ratchet-tree leaf: where it sits, whose it is (the agent
    id bytes its basic credential carries) and the 32-byte key it signs with
    (the `mls` field of the agent's certificate)."""

    @property
    def index(self) -> int: ...
    @property
    def identity(self) -> bytes: ...
    @property
    def signature_key(self) -> bytes: ...

class EscrowExport:
    """One installed epoch's read escrow, ready to seal: the epoch, its fork
    fingerprint (16 bytes) and the `EpochReadSecrets` v1 plaintext.

    `plaintext` is one `bytearray` (every read returns the same object): overwrite
    it with zeros once it is sealed."""

    @property
    def epoch(self) -> int: ...
    @property
    def fp(self) -> bytes: ...
    @property
    def plaintext(self) -> bytearray: ...

class EscrowGapReason:
    """Why an installed epoch has no escrow export. `value` is the snake_case
    name a client files its gap marker under."""

    CONTEXT_TOO_LARGE: EscrowGapReason
    TOO_MANY_LEAVES: EscrowGapReason
    MALFORMED: EscrowGapReason
    QUEUE_OVERFLOW: EscrowGapReason

    @property
    def value(self) -> str: ...

class EscrowGap:
    """An installed epoch that has no escrow: nothing can be sealed for it."""

    @property
    def group_id(self) -> bytes: ...
    @property
    def epoch(self) -> int: ...
    @property
    def reason(self) -> EscrowGapReason: ...
    @property
    def fp(self) -> Optional[bytes]: ...

class EscrowTake:
    """What one take yields: an export per epoch that could be encoded and a gap
    per epoch that could not."""

    @property
    def exports(self) -> list[EscrowExport]: ...
    @property
    def gaps(self) -> list[EscrowGap]: ...

class EscrowBacklog:
    """What a group holds for the next take: exports waiting, and epochs already
    discarded past the group's cap."""

    @property
    def queued(self) -> int: ...
    @property
    def dropped(self) -> int: ...

class OpenedMessage:
    """An application message opened by an `EpochReader`: the signed rine
    envelope, its sender's leaf, the signature key it verified under and its ratchet
    generation."""

    @property
    def envelope(self) -> bytes: ...
    @property
    def sender_index(self) -> int: ...
    @property
    def signer_public_key(self) -> bytes: ...
    @property
    def generation(self) -> int: ...

class AllowedIdentities:
    """The (agent id, leaf signature public key) pairs a client accepts as group
    members; shared by every client it is passed to."""

    def __init__(self) -> None: ...
    def insert(self, agent_id: bytes, leaf_public_key: bytes, key_gen: int) -> None:
        """Admit the pair at `key_gen`, the generation the agent's certificate
        chain signs for that key. The same pair again at the same generation is
        a no-op; at another one it raises `AllowedGenerationConflictError`."""

    def contains(self, agent_id: bytes, leaf_public_key: bytes) -> bool: ...

class EpochReader:
    """Opens the application messages of one (group, epoch) from its escrow
    plaintext, as a party that was never a member."""

    @staticmethod
    def from_escrow(group_id: bytes, epoch: int, plaintext: bytes) -> EpochReader: ...
    def open(self, message: bytes) -> OpenedMessage: ...

class MlsGroup:
    def group_id(self) -> bytes: ...
    def epoch(self) -> int: ...
    def cipher_suite(self) -> int: ...
    def is_active(self) -> bool: ...
    def member_index(self, identity: bytes) -> int: ...
    def member_identities(self) -> list[MemberIdentity]: ...
    def current_member_index(self) -> int: ...
    def own_leaf_signature_key(self) -> bytes: ...
    def commit_update(self, new_leaf_seed: bytes) -> CommitBundle:
        """Commit a move of this member's own leaf to the key derived from
        `new_leaf_seed`. The commit stays pending: nothing on this handle changes
        until `apply_pending_commit()`, and `add_member`, `remove_member` and
        another `commit_update` raise `CommitPendingError` meanwhile."""
    def pending_commit_epoch(self) -> Optional[int]:
        """The epoch the pending commit would move this handle to, or `None`."""
    def apply_pending_commit(self) -> int:
        """Apply the pending commit and return the new epoch."""
    def clear_pending_commit(self) -> None:
        """Drop the pending commit, restoring the state before `commit_update`."""
    def group_info(self) -> bytes: ...
    def last_commit(self) -> Optional[CommitBundle]: ...
    def add_member(self, key_package: bytes) -> CommitBundle: ...
    def add_members(self, key_packages: list[bytes]) -> CommitBundle: ...
    def remove_member(self, leaf_index: int) -> CommitBundle: ...
    def apply_commit(self, commit: bytes) -> int: ...
    def encrypt_application_message(self, envelope: bytes) -> bytes: ...
    def decrypt_application_message(self, payload: bytes) -> AppMessage: ...
    def epoch_fingerprint(self) -> bytes: ...
    def take_escrow_exports(self) -> EscrowTake: ...
    def queued_escrow_fingerprints(self) -> list[tuple[int, bytes]]:
        """One ``(epoch, fingerprint)`` tuple per export still queued, oldest first.

        The same pairs the Node binding returns as ``EpochFingerprint`` objects.
        Read from a clone, so the backlog is untouched.
        """
        ...
    def escrow_backlog(self) -> EscrowBacklog: ...
    def refused_peer(self) -> Optional[bytes]: ...
    def save(self) -> None: ...

class MlsClient:
    def __init__(
        self,
        store_root: str,
        agent_id: bytes,
        leaf_seed: bytes,
        allowed: AllowedIdentities,
        cipher_suite: int,
        *,
        epoch_retention_limit: Optional[int] = None,
    ) -> None: ...
    def cipher_suite(self) -> int: ...
    def agent_id(self) -> bytes: ...
    def leaf_public_key(self) -> bytes: ...
    def generate_key_package(self) -> bytes: ...
    def generate_key_packages(self, count: int) -> list[bytes]: ...
    def key_package_count(self) -> int: ...
    def discard_welcome_key_package(self, welcome: bytes) -> bool: ...
    def refused_peer(self) -> Optional[bytes]: ...
    def replenish_key_packages(self) -> list[bytes]: ...
    def drain_and_republish_key_packages(self) -> list[bytes]: ...
    def create_group(self, group_id: bytes) -> MlsGroup: ...
    def create_group_with_members(
        self, group_id: bytes, key_packages: list[bytes]
    ) -> MlsGroup: ...
    def join_from_welcome(self, welcome: bytes) -> MlsGroup: ...
