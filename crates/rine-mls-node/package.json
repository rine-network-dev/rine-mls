{
  "name": "@rine-network/mls",
  "version": "0.1.0",
  "description": "rine's MLS group core (RFC 9420) with the X-Wing post-quantum ciphersuite",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/rine/rine-src.git",
    "directory": "rine-mls/crates/rine-mls-node"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "engines": {
    "node": ">= 20"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "napi": {
    "binaryName": "rine-mls",
    "packageName": "@rine-network/mls",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin"
    ]
  },
  "optionalDependencies": {
    "@rine-network/mls-linux-x64-gnu": "0.1.0",
    "@rine-network/mls-linux-arm64-gnu": "0.1.0",
    "@rine-network/mls-linux-x64-musl": "0.1.0",
    "@rine-network/mls-linux-arm64-musl": "0.1.0",
    "@rine-network/mls-darwin-x64": "0.1.0",
    "@rine-network/mls-darwin-arm64": "0.1.0"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "build:probe": "napi build --platform --release --features panic-probe",
    "create-npm-dirs": "napi create-npm-dirs",
    "artifacts": "napi artifacts",
    "test": "bash test/run.sh",
    "test:unit": "node --test \"test/*.test.mjs\"",
    "test:package": "bash test/package.sh"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.7.4"
  }
}
